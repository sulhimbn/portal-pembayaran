# Portal Pembayaran QRIS — contoh env (JANGAN isi nilai asli di sini).
# Salin ke .env.local untuk dev lokal, atau ke .dev.vars untuk wrangler dev.
# Semua file .env* dan .dev.vars sudah diignore git (tidak akan ke-commit).
#
# Produksi (Cloudflare): JANGAN pakai file ini.
# Set via dashboard atau `wrangler secret put <NAMA>` per baris di bawah.

# --- Wajib (Worker secrets, min 32 char acak) ---
SESSION_SECRET=
ENCRYPTION_KEY=
# Opsional tapi disarankan untuk webhook sandbox/simulated:
WEBHOOK_SECRET=

# --- QRIS: pilih SALAH SATU provider (lihat QRIS_PROVIDER di bawah) ---
# Xendit (test mode dulu):
XENDIT_API_KEY=
XENDIT_WEBHOOK_TOKEN=
# Midtrans (sandbox dulu):
MIDTRANS_SERVER_KEY=
MIDTRANS_CLIENT_KEY=

# --- Non-rahasia (boleh juga di wrangler.toml [vars]) ---
QRIS_PROVIDER=simulated
# ganti ke salah satu bila key sudah terpasang:
# QRIS_PROVIDER=xendit
# QRIS_PROVIDER=midtrans

# --- Cloudflare (untuk tooling lokal: wrangler deploy, MCP) ---
# JANGAN commit token ini. Untuk CI pakai GitHub Secrets.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=d4e5e83bb56cdc9439f4c39885f7aedf

# --- ID resource yang sudah dibuat via MCP (2026-10-10) ---
D1_DATABASE_ID=48151ca6-b960-4144-b379-6c11571c1bcb
R2_BUCKET_NAME=portal-pembayaran-assets

# Salin ke .dev.vars untuk `wrangler dev --local` (JANGAN commit .dev.vars).
# Format: KEY = "value" (sama seperti .env.local).
# Produksi: JANGAN pakai file ini — set via `wrangler secret put <NAMA>`.
SESSION_SECRET = "dev-min-32-char-ganti-sebelum-produksi-1234"
QRIS_PROVIDER = "simulated"
# Kunci enkripsi kredensial layanan (AES-GCM). Wajib di produksi via
# `wrangler secret put ENCRYPTION_KEY`; tanpa ini dipakai fallback dev
# (JANGAN untuk produksi).
ENCRYPTION_KEY = "dev-min-32-char-ganti-sebelum-produksi-5678"
